# ─────────────────────────────────────────────────────────────
# RACE Coach environment
# ─────────────────────────────────────────────────────────────
#
# Choose the data store. "local" needs no setup; "supabase" enables the
# cross-device admin dashboard.
VITE_STORE=local

# Groq API key. WARNING: VITE_ vars are inlined into the public browser bundle,
# so this key ships to every visitor of a deployed site. Acceptable for local /
# classroom use; for a public deploy, use a serverless proxy that holds the key.
# An in-app "Coach key" dialog can also override this at runtime (sessionStorage).
VITE_GROQ_API_KEY=

# Admin login uses Supabase Auth (create the admin user in the Supabase dashboard).
# No admin credentials live in this file.

# Only needed when VITE_STORE=supabase. The anon/public key is safe to ship.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
